discovery.docker "app" {
  host = "unix:///var/run/docker.sock"
  filter {
    name = "label"
    values = ["com.docker.compose.project=" + sys.env("COMPOSE_PROJECT")]
  }
}

discovery.relabel "logs" {
  targets = discovery.docker.app.targets
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    regex = "ep02-(backend|frontend|db)"
    action = "keep"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label = "service"
    regex = "ep02-(.*)"
    replacement = "$1"
  }
  rule {
    target_label = "environment"
    replacement = "local"
  }
}

loki.source.docker "app" {
  host = "unix:///var/run/docker.sock"
  targets = discovery.relabel.logs.output
  labels = {job = "empresas"}
  forward_to = [loki.process.sanitize.receiver]
}
