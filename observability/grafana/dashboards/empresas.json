{
  "uid": "empresas-ep3",
  "title": "Empresas · EP3 · Operación y CI/CD",
  "schemaVersion": 39,
  "version": 4,
  "editable": false,
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "tags": [
    "EP3",
    "Empresas"
  ],
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "Entorno",
        "type": "custom",
        "query": "local,eks",
        "current": {
          "text": "local",
          "value": "local"
        },
        "options": [
          {
            "text": "local",
            "value": "local",
            "selected": true
          },
          {
            "text": "eks",
            "value": "eks",
            "selected": false
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Despliegue verificado (último éxito)",
      "type": "stat",
      "description": "Duración real de aplicación y comprobación. Local y EKS separados; no incluye espera de runners ni build.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ep3_deployment_duration_seconds{instance=\"ep3-files\",environment=\"$environment\"}",
          "instant": true,
          "legendFormat": "{{service}}{{pod}}{{component}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "Sin datos",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 2,
      "title": "Cobertura backend",
      "type": "stat",
      "description": "JaCoCo: alcance del gate, excluye Application. Snapshot del run identificado debajo.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * ep3_test_coverage_ratio{instance=\"ep3-files\",environment=\"$environment\",component=\"backend\"}",
          "instant": true,
          "legendFormat": "{{service}}{{pod}}{{component}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "Sin datos",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 100
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 3,
      "title": "Cobertura frontend",
      "type": "stat",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * ep3_test_coverage_ratio{instance=\"ep3-files\",environment=\"$environment\",component=\"frontend\"}",
          "instant": true,
          "legendFormat": "{{service}}{{pod}}{{component}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "Sin datos",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 100
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 4,
      "title": "Disponibilidad API observada",
      "type": "stat",
      "description": "Sonda desde el recolector. Solo muestras observadas; huecos sin recolección no se consideran disponibilidad.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * avg_over_time(probe_success{environment=\"$environment\",service=\"api\"}[$__range])",
          "instant": true,
          "legendFormat": "{{service}}{{pod}}{{component}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "Sin datos",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 5,
      "title": "CPU de contenedores",
      "type": "timeseries",
      "description": "Local: Docker CLI (requiere local-resources.py). EKS: kubelet/cAdvisor; nunca CPU JVM presentada como CPU de todos los contenedores.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(ep3_container_cpu_cores{instance=\"ep3-files\",environment=\"$environment\"} and on(environment) (time()-ep3_resources_timestamp_seconds < 60)) or sum by(pod) (rate(container_cpu_usage_seconds_total{environment=\"$environment\",container!=\"POD\",container!=\"\",namespace=\"ep02\"}[2m]))",
          "instant": false,
          "legendFormat": "{{service}}{{pod}}{{component}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cores",
          "noValue": "Sin datos"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 6,
      "title": "Memoria de contenedores",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(ep3_container_memory_bytes{instance=\"ep3-files\",environment=\"$environment\"} and on(environment) (time()-ep3_resources_timestamp_seconds < 60)) or sum by(pod) (container_memory_working_set_bytes{environment=\"$environment\",container!=\"POD\",container!=\"\",namespace=\"ep02\"})",
          "instant": false,
          "legendFormat": "{{service}}{{pod}}{{component}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "Sin datos"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 7,
      "title": "Solicitudes HTTP por segundo",
      "type": "stat",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 13
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{environment=\"$environment\",uri!~\"/actuator.*\"}[2m]))",
          "instant": true,
          "legendFormat": "{{service}}{{pod}}{{component}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "Sin datos",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 8,
      "title": "Errores HTTP 5xx / segundo",
      "type": "stat",
      "description": "Cero solo si existen solicitudes observadas y el scrape backend está disponible. Sin telemetría no se inventa disponibilidad ni errores.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 13
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(http_server_requests_seconds_count{environment=\"$environment\",status=~\"5..\"}[2m])) or (sum(rate(http_server_requests_seconds_count{environment=\"$environment\"}[2m])) * 0)) and on() (min(up{job=\"empresas-backend\",environment=\"$environment\"}) == 1)",
          "instant": true,
          "legendFormat": "{{service}}{{pod}}{{component}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "Sin datos",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1e-09
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 9,
      "title": "Latencia HTTP p95",
      "type": "stat",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 13
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by(le)(rate(http_server_requests_seconds_bucket{environment=\"$environment\",uri!~\"/actuator.*\"}[2m])))",
          "instant": true,
          "legendFormat": "{{service}}{{pod}}{{component}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "Sin datos",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 10,
      "title": "PostgreSQL accesible",
      "type": "stat",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 13
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pg_up{environment=\"$environment\"}",
          "instant": true,
          "legendFormat": "{{service}}{{pod}}{{component}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bool",
          "noValue": "Sin datos",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 11,
      "title": "Edad del snapshot CI",
      "type": "stat",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 18
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time()-ep3_ci_timestamp_seconds{instance=\"ep3-files\",environment=\"$environment\"}",
          "instant": true,
          "legendFormat": "{{service}}{{pod}}{{component}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "Sin datos",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 12,
      "title": "Último despliegue verificado",
      "type": "stat",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 18
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ep3_deployment_timestamp_seconds{instance=\"ep3-files\",environment=\"$environment\"} * 1000",
          "instant": true,
          "legendFormat": "{{service}}{{pod}}{{component}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeAsIso",
          "noValue": "Sin datos",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 13,
      "title": "Procedencia CI: SHA, run e intento",
      "type": "table",
      "description": "origin=local nunca se presenta como una ejecución de GitHub. Los artefactos son el registro canónico por run.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ep3_ci_run_info{instance=\"ep3-files\",environment=\"$environment\"}",
          "instant": true,
          "legendFormat": "{{service}}{{pod}}{{component}}",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Sin datos"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "SHA"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 350
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "Value": true
            },
            "indexByName": {
              "origin": 0,
              "sha": 1,
              "run_id": 2,
              "attempt": 3,
              "environment": 4,
              "working_tree": 5
            },
            "renameByName": {
              "origin": "Origen",
              "sha": "SHA",
              "run_id": "Run",
              "attempt": "Intento",
              "environment": "Entorno",
              "working_tree": "Archivos"
            }
          }
        }
      ]
    },
    {
      "id": 14,
      "title": "Errores registrados",
      "type": "stat",
      "description": "Eventos ERROR o respuestas HTTP 4xx/5xx observadas. No se interpreta ausencia de datos como cero.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({environment=\"$environment\",service=~\"backend|frontend|db\"} |~ \"(?i)(error|status=[45][0-9][0-9])\" [$__range]))",
          "instant": true,
          "legendFormat": "{{service}}{{pod}}{{component}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Sin datos",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1e-09
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 15,
      "title": "Logs de Empresas, frontend y PostgreSQL",
      "type": "logs",
      "description": "Buscar request_id para correlacionar Nginx con el access log Tomcat. No son trazas distribuidas.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 28
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{environment=\"$environment\",service=~\"backend|frontend|db\"}",
          "instant": false,
          "legendFormat": "{{service}}{{pod}}{{component}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Sin datos"
        },
        "overrides": []
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      }
    }
  ]
}
